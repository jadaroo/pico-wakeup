// Copy this file to secrets.h and fill in real values.
// secrets.h is listed in .gitignore so it never gets committed.
#ifndef SECRETS_H
#define SECRETS_H

// Home Wi-Fi the Pico joins (2.4 GHz only - the CYW43439 has no 5 GHz radio)
#define WIFI_SSID       "your-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// EMQX Cloud deployment: Overview -> Connection Information -> "Address"
// (no mqtts:// prefix, no port)
#define MQTT_BROKER_HOST "xxxxxxxx.ala.eu-central-1.emqxsl.com"

// EMQX Cloud: Access Control -> Authentication. Use a login just for the Pico.
#define MQTT_USERNAME   "pico"
#define MQTT_PASSWORD   "your-mqtt-password"

#endif
